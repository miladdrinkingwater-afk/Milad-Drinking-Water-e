# Firebase Configuration Example for Milad Drinking Water
# Copy this file to .env or .env.local and insert your real Firebase project credentials.
# Note: NEVER commit .env with real production private keys to version control.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=milad-drinking-water.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=milad-drinking-water
VITE_FIREBASE_STORAGE_BUCKET=milad-drinking-water.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional App Check ReCaptcha v3 / Enterprise Site Key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
